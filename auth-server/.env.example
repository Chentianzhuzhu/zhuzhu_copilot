# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=zhuzhu_copilot_auth

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=你的redis密码

# JWT 配置
# 生产环境必须使用强随机密钥（≥32 字符）：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_this_to_a_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 安全加固：为 true 时拒绝用默认/弱 JWT 密钥启动（生产环境务必开启）
REQUIRE_STRONG_JWT_SECRET=false

# 客户端 access token 有效期（分钟），由 /api/auth/refresh 滑动续期
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 登录安全：失败锁定（同一账号/IP 在窗口内累计失败达到阈值即锁定）
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=5
LOGIN_FAIL_WINDOW_MINUTES=5

# 登录握手 state（防 login CSRF / 重放）
# 客户端登录前申请一次性随机 state，登录成功后原样回传校验并消费。
LOGIN_STATE_TTL_SECONDS=600
# 为 true 时强制要求登录/注册携带有效 state（建议生产开启）
REQUIRE_LOGIN_STATE=false

# 管理员登录安全：更严格，防止爆破后台
ADMIN_MAX_FAIL=5
ADMIN_LOCK_MINUTES=15

# CORS：生产环境应配置为具体前端来源（逗号分隔），如 https://chentian.dpdns.org
# 留空或 * 表示允许所有来源（此时不允许携带凭证）。
CORS_ORIGINS=*

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 默认管理员
ADMIN_USERNAME=zhutianlaing
ADMIN_PASSWORD=windows10