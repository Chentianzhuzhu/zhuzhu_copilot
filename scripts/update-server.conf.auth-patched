server {
    listen 80;
    server_name chentian.dpdns.org;
    client_max_body_size 600m;

    location = /admin { return 302 /admin/index.html; }
    location /admin { return 404; }

    location /downloads/ {
        alias /www/update-server/uploads/pkg/;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        expires off;
        access_log off;
    }

    # zhuzhu Copilot 认证服务（auth-server :8000）经此路径反代
    location /authapp/ws {
        proxy_pass http://127.0.0.1:8000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /authapp/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 旧静态官网已下线：301 归并到本站根路径，避免与本站（Spring 服务端渲染，canonical
    # 取自 SITE_BASE_URL）构成两个「官方站」被判重复收录。
    # 用 return 而非 root/index：不碰文件系统，/var/www/website/ 归档或删除后仍稳定跳转。
    location /website/ { return 301 $scheme://$host/; }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:8080;
    }
}

server {
    listen 443 ssl http2;
    server_name chentian.dpdns.org;
    ssl_certificate     /etc/nginx/ssl/chentian.dpdns.org.crt;
    ssl_certificate_key /etc/nginx/ssl/chentian.dpdns.org.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 600m;

    location = /admin { return 302 /admin/index.html; }
    location /admin { return 404; }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # zhuzhu Copilot 认证服务（auth-server :8000）经此路径反代（HTTPS，传输加密）
    location /authapp/ws {
        proxy_pass http://127.0.0.1:8000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /authapp/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:8080;
    }

    location /downloads/ {
        alias /www/update-server/uploads/pkg/;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        expires off;
        access_log off;
    }

    # 旧静态官网已下线：301 归并到本站根路径，避免与本站（Spring 服务端渲染，canonical
    # 取自 SITE_BASE_URL）构成两个「官方站」被判重复收录。
    # 用 return 而非 root/index：不碰文件系统，/var/www/website/ 归档或删除后仍稳定跳转。
    location /website/ { return 301 $scheme://$host/; }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}