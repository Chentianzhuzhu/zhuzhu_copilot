# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.log

# Cython build artifacts (.c generated from .py)
src/zhuzhu_Copilot/**/*.c

# Code-signing private key (public .cer / bat are committed)
build/certs/*.pfx

# PyInstaller
build/__pycache__/
build/zhuzhu_Copilot/
build/setup/
build/uninstall/
build/build/
installer/build/
# 构建期预下载的沙盒运行时（Node/Python，体积大），不入库
build/runtime_bundle/
# 构建期预下载的 VC++ 运行库安装器（体积大），不入库，缺则构建脚本自动下载
build/redist/
dist/
dist_new/
*.spec
!build/zhuzhu_Copilot.spec

# Inno Setup
Output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# 临时/诊断脚本与产物（根目录及 scripts 下的 _ 前缀文件）
# 注意：`scripts/_` 只匹配名为 `_` 的单项，写 `scripts/_*` 才是指前缀匹配。
# 历史遗留：scripts/_*.py 已有大量文件被跟踪，改本行不会让它们脱离跟踪（需 git rm --cached）。
/_*
scripts/_*
scripts._*
!/.gitignore
_build_*.txt

# 本地个人数据与个人化工作流种子（含用户私人内容，不入库）
/memory.md
build/workflows_seed/romance_companion/

# 评审/调试用的临时目录（脚本与中间产物，不入库）
.review_tmp/

# 构建中间产物与运行时输出
src/build/
tts_output/
src/tts_output/

# 微信 ClawBot 入站文件落盘目录（用户上传的文件，属运行时数据，不入库）
wechat_inbox/
src/_focus.log
src/_wfa_result.json
src/*.pyc

# 文档产物
*.docx

# ---- 补充：体积大或可再生的本地产物（不入库） ----
# 下载的第三方安装包（msys2 等，体积大，可重新获取）
downloads/
# src 的重复压缩包（源码已由版本控制管理）
src.zip
# 本地 agent 备份快照（与源码重复）
.workbuddy/backup_*/
# 构建期日志（*.log 已忽略，此处补 .txt 命名的同类产物）
build/build_log*.txt
build/smoke_result.txt

# 本地仓库历史备份快照（体积大，且与源码重复；勿入库）
.git_broken_backup/

# 第三方 npm 包本地解压与 tarball（不入库）
package/
*.tgz
