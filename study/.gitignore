# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.log

# Cython build artifacts (.c generated from .py)
src/zhuzhu_Copilot/**/*.c

# Code-signing private key (public .cer / bat are committed)
build/certs/*.pfx

# PyInstaller
build/__pycache__/
build/zhuzhu_Copilot/
build/setup/
build/uninstall/
build/build/
installer/build/
# 构建期预下载的沙盒运行时（Node/Python，体积大），不入库
build/runtime_bundle/
# 构建期预下载的 VC++ 运行库安装器（体积大），不入库，缺则构建脚本自动下载
build/redist/
dist/
dist_new/
*.spec
!build/zhuzhu_Copilot.spec

# Inno Setup
Output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# 临时/诊断脚本与产物（根目录及 scripts 下的 _ 前缀文件）
/_*
scripts/_
scripts._*
!/.gitignore
_build_*.txt

# 构建中间产物与运行时输出
src/build/
tts_output/
src/tts_output/
src/_focus.log
src/_wfa_result.json
src/*.pyc

# 文档产物
*.docx
